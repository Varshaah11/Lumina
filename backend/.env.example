# Lumina AI - Backend Environment Variables
# Copy this file to .env and fill in the values

PROJECT_NAME=Lumina AI
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
# Session lifetime in minutes. Used for BOTH the JWT expiry and the auth cookie Max-Age (default 10080 = 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Auth cookie (always HttpOnly). Set AUTH_COOKIE_SECURE=true when serving over HTTPS.
AUTH_COOKIE_NAME=token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

# Login brute-force protection (in-process)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_FAILED_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
DATABASE_URL=sqlite:///./lumina.db
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192

# POST /tts input limit in characters (oversized text is rejected with HTTP 400, never truncated)
KOKORO_MAX_TEXT_LENGTH=2000

# Max upload size in MB for POST /upload (checked before the file is loaded; oversized uploads get HTTP 413)
MAX_UPLOAD_SIZE_MB=10

# Browser origins allowed to call this API with credentials (the HttpOnly auth cookie). Comma-separated,
# scheme://host[:port], no paths or wildcards. Add your frontend origin(s) when deploying, e.g.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Ollama chat models. The strong model handles coding/reasoning/document tasks; the fast model handles general chat,
# voice and titles and is the fallback if the strong one is missing or fails.
OLLAMA_PRIMARY_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# Kokoro TTS: voice name and CPU threads per ONNX worker session
KOKORO_VOICE=af_sarah
KOKORO_THREADS=4
